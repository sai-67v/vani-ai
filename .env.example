# =====================
# SYSTEM
# =====================
PORT=3001

# =====================
# VAPI
# =====================
VAPI_API_KEY=your_vapi_api_key_here
VAPI_ASSISTANT_ID=your_vapi_assistant_id_here
VAPI_PHONE_NUMBER_ID=your_vapi_phone_number_id_here

# =====================
# SARVAM AI
# =====================
SARVAM_API_KEY=your_sarvam_api_key_here

# =====================
# SUPABASE (backend — server-side only)
# =====================
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# =====================
# DASHBOARD (Next.js — prefix NEXT_PUBLIC_ for client-side)
# =====================
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here

# =====================
# PUBLIC WEBHOOK BASE URL
# =====================
# Set to your ngrok / production URL. Leave blank to auto-detect from request Host.
PUBLIC_BASE_URL=https://your-tunnel.ngrok-free.app
